# Scalario — root environment variables (consumed by docker-compose)
# Copy this file to .env and fill in values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=scalario
POSTGRES_USER=scalario
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# --- NestJS ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://scalario:change_me_postgres@postgres:5432/scalario
REDIS_URL=redis://:change_me_redis@redis:6379
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
FASTAPI_URL=http://fastapi:8000

# --- MinIO (Phase 2 stub) ---
MINIO_ROOT_USER=scalario_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=scalario_minio
MINIO_SECRET_KEY=change_me_minio
