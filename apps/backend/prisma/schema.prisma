generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["kernel", "shared", "retail"]
}

// ═══════════════════════════════════════════
// KERNEL SCHEMA
// ═══════════════════════════════════════════

model Tenant {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  currency              String               @default("XOF")
  timezone              String               @default("Africa/Abidjan")
  fiscalJurisdiction    String?              @map("fiscal_jurisdiction")
  status                String               @default("active") // active, suspended, archived
  sessionTimeoutMinutes Int                  @default(480) @map("session_timeout_minutes")
  orgMode               String               @default("standalone") @map("org_mode") // standalone | integrated | federated (Phase 3)

  /// Phase 2b — Programme Ambassadeurs. FK to tenants.id. Populated when tenant is created via referral.
  referredBy            String?              @map("referred_by") @db.Uuid
  /// Phase 3 — Scalario Connect. Tenant is discoverable on the B2B network when true.
  networkVisible        Boolean              @default(false) @map("network_visible")
  /// Phase 3 — Scalario Enterprise. FK to tenants.id of the parent Groupe tenant (federated mode only).
  parentTenantId        String?              @map("parent_tenant_id") @db.Uuid

  /// Epic 22 — Notification settings
  dailySummaryEnabled   Boolean              @default(false) @map("daily_summary_enabled")
  dailySummaryTime      String               @default("18:00") @map("daily_summary_time")
  notificationChannel   String               @default("in_app") @map("notification_channel")
  lastSummarySentDate   DateTime?            @map("last_summary_sent_date") @db.Timestamptz(6)

  /// Epic 24 — Freshness color-code thresholds (percent)
  freshnessGreenThreshold  Int               @default(50) @map("freshness_green_threshold")
  freshnessOrangeThreshold Int               @default(20) @map("freshness_orange_threshold")

  /// Epic 27 — Return policy (FR98)
  returnPolicyDays         Int               @default(30) @map("return_policy_days")
  returnRequiresReason     Boolean           @default(true) @map("return_requires_reason")
  returnRequiresApproval   Boolean           @default(false) @map("return_requires_approval")

  /// Epic 28 — Billing (FR100–FR103)
  plan                     String            @default("free")
  maxUsers                 Int               @default(1) @map("max_users")
  installationFee          Decimal?          @map("installation_fee") @db.Decimal(10, 0)
  installationPaid         Boolean           @default(false) @map("installation_paid")
  trainingFee              Decimal?          @map("training_fee") @db.Decimal(10, 0)
  trainingPaid             Boolean           @default(false) @map("training_paid")
  billingStartDate         DateTime?         @map("billing_start_date") @db.Timestamptz(6)
  billingStatus            String            @default("trial") @map("billing_status") // trial | active | overdue | suspended
  trialEndsAt              DateTime?         @map("trial_ends_at") @db.Timestamptz(6)
  overdueAt                DateTime?         @map("overdue_at") @db.Timestamptz(6)
  notes                    String?
  billingEvents            BillingEvent[]

  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  auditLogs             AuditLog[]
  categories            Category[]
  members               OrganizationMember[]
  posSessions           PosSession[]
  terminalStatuses      TerminalStatus[]
  tenantModules         TenantModule[]
  expenses              Expense[]

  @@map("tenants")
  @@schema("kernel")
}

// ─── Epic 28: FR100 — Plan Definitions ────────────────────────────────────────
model PlanDefinition {
  id                       String   @id @default(uuid()) @db.Uuid
  code                     String   @unique
  name                     String
  monthlyPrice             Decimal  @map("monthly_price") @db.Decimal(10, 0)
  maxUsers                 Int      @map("max_users")
  includedModules          String[] @map("included_modules")
  suggestedInstallationFee Decimal? @map("suggested_installation_fee") @db.Decimal(10, 0)
  suggestedTrainingFee     Decimal? @map("suggested_training_fee") @db.Decimal(10, 0)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("plan_definitions")
  @@schema("kernel")
}

// ─── Epic 28: FR101–FR103 — Billing Events ────────────────────────────────────
model BillingEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String    // subscription | installation | training | upgrade | downgrade | payment | upgrade_request
  amount        Decimal   @db.Decimal(10, 0)
  description   String?
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  dueDate       DateTime? @map("due_date") @db.Timestamptz(6)
  status        String    @default("pending") // pending | paid | overdue | cancelled
  paymentMethod String?   @map("payment_method") // cash | mobile_money | card | bank_transfer
  paymentRef    String?   @map("payment_ref")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("billing_events")
  @@schema("kernel")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [organizationId], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])

  /// Phase 3 — Scalario Enterprise. Department memberships. Empty array in Retail mode.
  departmentIds  String[] @default([]) @map("department_ids") @db.Uuid

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("kernel")
}

model Role {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  vertical    String
  members     OrganizationMember[]
  permissions RolePermission[]

  @@unique([name, vertical])
  @@map("roles")
  @@schema("kernel")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]

  @@map("permissions")
  @@schema("kernel")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("kernel")
}

model Module {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String         @unique
  name         String
  type         String         // "shared" | "vertical"
  dependencies String[]
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenants      TenantModule[]

  @@map("modules")
  @@schema("kernel")
}

model TenantModule {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  status      String    @default("inactive") // "active" | "inactive" | "available_phase3"
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  /// Phase 3 — Scalario Enterprise. Null = tenant-wide activation (Retail). Set = department-scoped activation.
  departmentId String?  @map("department_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  module      Module    @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
  @@schema("kernel")
}

model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  action    String    // "CREATE" | "UPDATE" | "DELETE"
  entity    String
  entityId  String    @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityId])
  @@map("audit_log")
  @@schema("kernel")
}

// ═══════════════════════════════════════════
// SHARED SCHEMA
// ═══════════════════════════════════════════

model CatalogItem {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  price             Decimal   @db.Decimal(10, 2)
  barcode           String?
  itemType          String    @default("physical") @map("item_type")
  // Valid values: 'physical' | 'bookable' | 'service'
  categoryId        String?   @map("category_id") @db.Uuid
  category          Category? @relation(fields: [categoryId], references: [id])
  tenantId          String    @map("tenant_id") @db.Uuid
  isDeleted         Boolean   @default(false) @map("is_deleted")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Phase 3 — Scalario Connect. Supplier's reference ID for this item on the B2B network.
  supplierReference String?       @map("supplier_reference") @db.Uuid

  // Epic 20 — Vente au poids + unités configurables
  // Valid values: 'piece' | 'weight' | 'volume' | 'length'
  unitType          String        @default("piece") @map("unit_type")
  pricePerUnit      Decimal?      @map("price_per_unit") @db.Decimal(10, 2)
  conversionRate    Decimal?      @map("conversion_rate") @db.Decimal(10, 4)

  // Epic 23 — Conversion vrac → détail
  parentItemId      String?       @map("parent_item_id") @db.Uuid
  parent            CatalogItem?  @relation("ParentChild", fields: [parentItemId], references: [id])
  children          CatalogItem[] @relation("ParentChild")

  // Epic 24 — Fraîcheur + code couleur
  expiryDays          Int?          @map("expiry_days")
  shrinkageTolerance  Decimal?      @map("shrinkage_tolerance") @db.Decimal(5, 2)

  // Epic 25 — Variantes
  hasVariants         Boolean       @default(false) @map("has_variants")

  // Epic 26 — Traçabilité Articles
  trackSerialNumbers  Boolean       @default(false) @map("track_serial_numbers")
  warrantyMonths      Int?          @map("warranty_months")
  requiresPrescription Boolean      @default(false) @map("requires_prescription")
  dynamicPricing      Boolean       @default(false) @map("dynamic_pricing")
  isUnique            Boolean       @default(false) @map("is_unique")

  retailProduct       RetailProduct?
  purchaseOrderLines  PurchaseOrderLine[]
  productBatches      ProductBatch[]
  variants            ProductVariant[]
  priceLevels         PriceLevel[]
  serialRecords       SerialRecord[]
  priceHistory        PriceHistory[]

  @@index([tenantId, updatedAt])
  @@index([tenantId, categoryId])
  @@index([barcode])
  @@map("catalog_items")
  @@schema("shared")
}

model Category {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  tenantId  String        @map("tenant_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  items     CatalogItem[]

  @@map("categories")
  @@schema("shared")
}

model Contact {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String?
  email          String?
  address        String?
  contactType    String   @default("customer") @map("contact_type")
  // Valid values: 'customer' | 'supplier' (Phase 3+)
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  tenantId       String   @map("tenant_id") @db.Uuid
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Phase 3 — Scalario Connect. Links this contact to a supplier Tenant on the B2B network.
  linkedTenantId String?  @map("linked_tenant_id") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, updatedAt])
  @@map("contacts")
  @@schema("shared")

  purchaseOrders PurchaseOrder[]
}

// ── Epic 21 — Commandes fournisseurs ──────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  // status: 'draft' | 'confirmed' | 'partially_received' | 'received' | 'cancelled'
  status       String              @default("draft")
  expectedDate DateTime?           @map("expected_date") @db.Date
  notes        String?
  tenantId     String              @map("tenant_id") @db.Uuid
  createdBy    String?             @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplierId   String?             @map("supplier_id") @db.Uuid
  supplier     Contact?            @relation(fields: [supplierId], references: [id])

  lines        PurchaseOrderLine[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("purchase_orders")
  @@schema("shared")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid()) @db.Uuid
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  catalogItemId    String?       @map("catalog_item_id") @db.Uuid
  catalogItem      CatalogItem?  @relation(fields: [catalogItemId], references: [id])
  expectedQuantity Decimal       @map("expected_quantity") @db.Decimal(10, 4)
  receivedQuantity Decimal?      @map("received_quantity") @db.Decimal(10, 4)
  qualityNotes     String?       @map("quality_notes")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
  @@schema("shared")
}

// ── Epic 27 — Retours Articles (FR98) ─────────────────────────────────────

model ReturnRecord {
  id              String   @id @default(uuid()) @db.Uuid
  originalTxId    String?  @map("original_tx_id") @db.Uuid
  catalogItemId   String   @map("catalog_item_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  quantity        Decimal  @db.Decimal(10, 4)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  // resolution: 'cash_refund' | 'credit_note' | 'exchange'
  resolution      String
  reason          String?
  approvedBy      String?  @map("approved_by") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([originalTxId])
  @@map("return_records")
  @@schema("shared")
}

// ── Epic 27 — Réservations avec acompte (FR99) ────────────────────────────

model Reservation {
  id                     String    @id @default(uuid()) @db.Uuid
  customerId             String    @map("customer_id") @db.Uuid
  itemsJson              Json      @map("items_json")
  totalAmount            Decimal   @map("total_amount") @db.Decimal(10, 2)
  depositAmount          Decimal   @map("deposit_amount") @db.Decimal(10, 2)
  remainingAmount        Decimal   @map("remaining_amount") @db.Decimal(10, 2)
  // status: 'pending' | 'completed' | 'cancelled'
  status                 String    @default("pending")
  depositTransactionId   String?   @map("deposit_transaction_id") @db.Uuid
  completionTransactionId String?  @map("completion_transaction_id") @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  createdBy              String    @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([customerId])
  @@map("reservations")
  @@schema("shared")
}

model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  itemsJson       Json     @map("items_json")
  paymentMethod   String?  @map("payment_method")
  paymentSplits   Json?    @map("payment_splits")
  lifecycleType   String   @default("instant") @map("lifecycle_type")
  // Valid values: 'instant' | 'accumulating' | 'scheduled'
  transactionType String   @default("sale") @map("transaction_type")
  // Valid values: 'sale' | 'transfer_inter_tenant' (Phase 3 — Scalario Connect, FR55)
  customerId      String?  @map("customer_id") @db.Uuid
  sessionId       String?  @map("session_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  metadata        Json?    @map("metadata")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  retailSale      RetailSale?

  @@index([tenantId, createdAt])
  @@index([customerId])
  @@map("transactions")
  @@schema("shared")
}

model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  catalogItemId String?  @map("catalog_item_id") @db.Uuid
  // Valid values: 'SALE' | 'DELIVERY' | 'TRANSFER_OUT' | 'TRANSFER_IN' | 'LOSS' | 'ADJUSTMENT'
  type          String
  quantity      Decimal  @db.Decimal(10, 2)
  reason        String?
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  referenceId   String?  @map("reference_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([catalogItemId])
  @@index([referenceId])
  @@map("stock_movements")
  @@schema("shared")
}

// ═══════════════════════════════════════════
// RETAIL SCHEMA
// ═══════════════════════════════════════════

model PosSession {
  id                  String       @id @default(uuid()) @db.Uuid
  openingBalance      Decimal      @map("opening_balance") @db.Decimal(10, 2)
  closingBalance      Decimal?     @map("closing_balance") @db.Decimal(10, 2)
  status              String       @default("OPEN") // OPEN | CLOSED
  userId              String       @map("user_id") @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  deviceId            String?      @map("device_id")
  openedAt            DateTime     @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt            DateTime?    @map("closed_at") @db.Timestamptz(6)
  theoreticalBalance  Decimal?     @map("theoretical_balance") @db.Decimal(10, 2)
  variance            Decimal?     @db.Decimal(10, 2)
  varianceExplanation String?      @map("variance_explanation")
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  retailSales         RetailSale[]

  @@index([tenantId, userId, status])
  @@map("pos_sessions")
  @@schema("retail")
}


model TerminalStatus {
  id       String   @id @default(uuid()) @db.Uuid
  deviceId String   @unique @map("device_id")
  status   String
  lastSeen DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)
  tenantId String   @map("tenant_id") @db.Uuid
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@map("terminal_statuses")
  @@schema("retail")
}

model RetailProduct {
  id            String      @id @default(uuid()) @db.Uuid
  catalogItemId String      @unique @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  stockQuantity Decimal     @default(0) @map("stock_quantity") @db.Decimal(10, 2)
  weightUnit    String?     @map("weight_unit")
  minStockLevel Decimal?    @map("min_stock_level") @db.Decimal(10, 2)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("retail_products")
  @@schema("retail")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String
  amount     Decimal  @db.Decimal(10, 2)
  category   String   // LOYER | SALAIRE | ELECTRICITE | AUTRE
  date       DateTime @db.Date
  notes      String?
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, date])
  @@map("expenses")
  @@schema("retail")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String   @default("low_stock")
  title       String
  body        String
  targetId    String?  @map("target_id") @db.Uuid
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
  @@schema("shared")
}

// Epic 25 — Variantes produit
model ProductVariant {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  tenantId      String      @map("tenant_id") @db.Uuid
  sku           String?
  barcode       String?
  price         Decimal     @db.Decimal(10, 2)
  stockQuantity Decimal     @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  attributes    Json        @default("{}")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, catalogItemId])
  @@index([barcode])
  @@map("prod_variants")
  @@schema("shared")
}

// Epic 25 — Multi-tarifs (niveaux de prix)
model PriceLevel {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogItemId String    @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  tenantId      String    @map("tenant_id") @db.Uuid
  levelCode     String    @map("level_code")
  label         String
  price         Decimal   @db.Decimal(10, 2)
  minQty        Int?      @map("min_qty")
  customerTypes String[]  @map("customer_types")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, catalogItemId])
  @@map("price_levels")
  @@schema("shared")
}

// Epic 25 — Promotions
model Promotion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  type         String    // PERCENT | BUY_N_GET_M | CROSSED_PRICE
  scope        String    // ITEM | CATEGORY
  scopeId      String    @map("scope_id") @db.Uuid
  value        Json
  startDate    DateTime  @map("start_date") @db.Timestamptz(6)
  endDate      DateTime  @map("end_date") @db.Timestamptz(6)
  status       String    @default("active") // active | inactive
  conflictRule String    @default("BEST") @map("conflict_rule") // BEST | FIRST
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, status, startDate, endDate])
  @@map("promotions")
  @@schema("shared")
}

// Epic 24 — Fraîcheur + code couleur priorité vente
model ProductBatch {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  tenantId      String      @map("tenant_id") @db.Uuid
  receivedAt    DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  initialQty    Decimal     @map("initial_qty") @db.Decimal(12, 3)
  remainingQty  Decimal     @map("remaining_qty") @db.Decimal(12, 3)
  batchRef       String?     @map("batch_ref")
  isDepleted     Boolean     @default(false) @map("is_depleted")
  bestBeforeDate DateTime?   @map("best_before_date") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, expiresAt])
  @@map("prod_batches")
  @@schema("shared")
}

// Epic 26 — Traçabilité : numéros de série
model SerialRecord {
  id            String      @id @default(uuid()) @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  serial        String
  soldAt        DateTime?   @map("sold_at") @db.Timestamptz(6)
  warrantyUntil DateTime?   @map("warranty_until") @db.Timestamptz(6)
  tenantId      String      @map("tenant_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, serial])
  @@index([catalogItemId])
  @@map("serial_records")
  @@schema("shared")
}

// Epic 26 — Traçabilité : historique des prix
model PriceHistory {
  id            String      @id @default(uuid()) @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  price         Decimal     @db.Decimal(12, 2)
  effectiveFrom DateTime    @map("effective_from") @db.Timestamptz(6)
  reason        String?
  tenantId      String      @map("tenant_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([catalogItemId, effectiveFrom])
  @@index([tenantId])
  @@map("price_history")
  @@schema("shared")
}

model RetailSale {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @unique @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  sessionId     String?     @map("session_id") @db.Uuid
  session       PosSession? @relation(fields: [sessionId], references: [id])
  receiptNumber String      @map("receipt_number")
  cashierId     String?     @map("cashier_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([cashierId])
  @@map("retail_sales")
  @@schema("retail")
}
