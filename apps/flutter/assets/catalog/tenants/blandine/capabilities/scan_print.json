{
  "capabilities": {
    "scan_barcode": {
      "engine": "sense",
      "trigger": "on_tap_button",
      "button_label": "Scanner",
      "pipeline": [
        { "registry": "sense", "fn": "scan_barcode", "output": "barcode" },
        { "registry": "vault", "fn": "find_product", "inputs": { "barcode": "$barcode" } }
      ]
    },
    "print_receipt": {
      "engine": "sense",
      "trigger": "after_sale_created",
      "device": "bluetooth_printer",
      "pipeline": [
        { "registry": "vault", "fn": "get", "source": "sales", "where": { "id": "$sale_id" }, "output": "sale" },
        { "registry": "sense", "fn": "print_receipt", "inputs": { "data": "$sale", "format": "thermal_80mm" } }
      ]
    },
    "gps_position": {
      "engine": "sense",
      "trigger": "on_login",
      "purpose": "delivery_tracking",
      "enabled": false
    }
  }
}
