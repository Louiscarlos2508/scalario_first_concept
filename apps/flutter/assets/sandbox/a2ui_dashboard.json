          {"label":"Hist.","icon":"history"},
          {"label":"Équipe","icon":"group"},
          {"label":"Plus","icon":"settings"}
        ]}}
      },"children":["dashboard_content"]},

      {"id":"dashboard_content","component":"Column","children":["kpi_heading","kpi_grid","ventes_heading","ventes_chart","bottom_row"]},

      {"id":"kpi_heading","component":"Heading","props":{"icon":"dashboard","title":"Vue d'ensemble","subtitle":"Indicateurs clés du jour","divider":true}},

      {"id":"kpi_grid","component":"Grid","props":{"columns":4,"gap":"md"},"children":["ca_jour","ca_mois","stock_total","commandes_jour"]},
      {"id":"ca_jour","component":"KPICard","variant":"default","text":"CA Jour","value":{"path":"/kpi/ca_jour"},"props":{"icon":"trending_up","unit":"FCFA","delta":"+12,3%","delta_positive":true}},
      {"id":"ca_mois","component":"KPICard","variant":"default","text":"CA Mois","value":{"path":"/kpi/ca_mois"},"props":{"icon":"calendar_month","unit":"FCFA","delta":"+8,7%","delta_positive":true}},
      {"id":"stock_total","component":"KPICard","variant":"default","text":"Stock Total","value":{"path":"/kpi/stock_total"},"props":{"icon":"inventory","unit":"articles","delta":"–3,2%","delta_positive":false}},
      {"id":"commandes_jour","component":"KPICard","variant":"default","text":"Commandes","value":{"path":"/kpi/commandes_jour"},"props":{"icon":"receipt","unit":"auj.","delta":"+2 vs hier","delta_positive":true}},

      {"id":"ventes_heading","component":"Heading","props":{"icon":"show_chart","title":"Évolution des ventes","subtitle":"7 derniers jours","divider":true}},

      {"id":"ventes_chart","component":"ChartBar","text":"Ventes 7 jours","props":{"data":{"path":"/ventes7j"}}},

      {"id":"bottom_row","component":"Row","props":{"gap":16},"children":["top_produits_section","cloture_card"]},

      {"id":"top_produits_section","component":"Column","props":{"gap":8},"children":["top_produits_heading","top_produits_table","stock_gauge"]},
      {"id":"top_produits_heading","component":"Heading","props":{"icon":"star","title":"Top 5 Produits","divider":false}},
      {"id":"top_produits_table","component":"DataTable","props":{"columns":[{"key":"rang","label":"#","align":"center"},{"key":"produit","label":"Produit","align":"left"},{"key":"quantite","label":"Qté","align":"right"},{"key":"montant","label":"Montant","align":"right"}],"rows":{"path":"/top_produits"}}},
      {"id":"stock_gauge","component":"Gauge","props":{"label":"Capacité d'inventaire","value":72,"min":0,"max":100,"suffix":"%","color":"primary"}},

      {"id":"cloture_card","component":"Card","props":{
        "header":{"component":"Column","children":["cloture_header_title"]},
        "body":{"component":"Column","children":["cloture_caisse","cloture_especes","cloture_mobile","cloture_totals"]},
        "footer":{"component":"Column","children":["cloture_btn","cloture_comment"]}
      }},
      {"id":"cloture_header_title","component":"Heading","props":{"icon":"receipt","title":"Clôture de Caisse","subtitle":"Arrêté du journal","divider":false}},
      {"id":"cloture_caisse","component":"Text","text":"Caisse: 850 000 FCFA","props":{"style":"body"}},
      {"id":"cloture_especes","component":"Text","text":"Espèces: 420 000 FCFA","props":{"style":"body"}},
      {"id":"cloture_mobile","component":"Text","text":"Mobile Money: 430 000 FCFA","props":{"style":"body"}},
      {"id":"cloture_totals","component":"Text","text":"Total: 850 000 FCFA","props":{"style":"titleMedium"}},
      {"id":"cloture_btn","component":"ScalarioButton","variant":"primary","text":"Valider la clôture","action":{"name":"flow.execute","event":{"name":"cloture_caisse","context":{"type":"caisse"}}}},
      {"id":"cloture_comment","component":"Input","props":{"label":"Commentaire","hint":"Motif ou note pour cette clôture","required":false}}
    ]
  }},

