[
  {"version":"v0.9","createSurface":{"surfaceId":"dashboard","catalogId":"scalario"}},

  {"version":"v0.9","updateComponents":{
    "surfaceId":"dashboard",
    "components":[
      {"id":"root","component":"Scaffold","props":{
        "appBar":{"component":"AppBar","variant":"brand","props":{"title":"SCALARIO","actions":[
          {"icon":"notifications","badge":3},
          {"icon":"light_mode"},
          {"icon":"account_circle"}
        ]}},
        "sidebar":{"component":"Sidebar","props":{"items":[
          {"label":"Accueil","icon":"home","selected":true},
          {"label":"Stock","icon":"inventory_2"},
          {"label":"Ventes","icon":"shopping_cart"},
          {"label":"Rapports","icon":"bar_chart"},
          {"label":"Équipe","icon":"group"},
          {"label":"Paramètres","icon":"settings"}
        ]}},
        "drawer":{"component":"Sidebar","props":{"items":[
          {"label":"Accueil","icon":"home","selected":true},
          {"label":"Stock","icon":"inventory_2"},
          {"label":"Ventes","icon":"shopping_cart"},
          {"label":"Rapports","icon":"bar_chart"},
          {"label":"Équipe","icon":"group"},
          {"label":"Paramètres","icon":"settings"}
        ]}},
