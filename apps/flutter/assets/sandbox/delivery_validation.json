{
  "screen": "delivery_validation",
  "schema_version": "1.0.0",
  "layout": "form",
  "title": "Réception livraison",
  "zones": {
    "main": [
      { "type": "FormSection", "variant": "default", "props": { "title": "Articles reçus" }, "children": [
        { "type": "DataTable", "variant": "compact", "props": { "columns": [ { "key": "product", "label": "Article" }, { "key": "expected", "label": "Attendu" }, { "key": "received", "label": "Reçu" }, { "key": "ecart", "label": "Écart" } ], "rows": [ { "product": "Tomates", "expected": 20, "received": 18, "ecart": -2 }, { "product": "Bananes", "expected": 15, "received": 15, "ecart": 0 }, { "product": "Oignons", "expected": 10, "received": 10, "ecart": 0 } ] } }
      ] },
      { "type": "FormSection", "variant": "default", "props": { "title": "Notes" }, "children": [
        { "type": "Input", "variant": "default", "props": { "label": "Commentaire", "name": "notes", "multiline": true } }
      ] }
    ],
    "actions": [
      { "type": "ActionButton", "variant": "primary", "props": { "label": "Valider la réception" } }
    ]
  }
}
