# NestJS — local environment variables
# Copy to .env (gitignored) and fill in. Production secrets via secrets manager.

NODE_ENV=development
PORT=3000

# PostgreSQL (pgvector)
DATABASE_URL=postgresql://scalario:change_me@postgres:5432/scalario

# Redis
REDIS_URL=redis://:change_me@redis:6379

# JWT — minimum 32 chars each, rotate at least quarterly
JWT_SECRET=
JWT_REFRESH_SECRET=

# FastAPI (Phase 2 stub)
FASTAPI_URL=http://fastapi:8000

# MinIO (Phase 2 stub)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
