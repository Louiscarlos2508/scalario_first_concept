{
  "id": "module_dashboard_commercial",
  "schema_version": "1.0.0",
  "name": "Dashboard Commercial",
  "i18n_key": "module.dashboard_commercial.name",
  "icon": "point_of_sale",
  "rbac_roles": ["COMMERCIAL"],
  "conflict_strategy": "server_wins",
  "entities": [],
  "actions": {},
  "screens": [
    {
      "screen": "dashboard_commercial_v1",
      "schema_version": "1.0.0",
      "layout": "dashboard",
      "i18n_key": "screen.dashboard_commercial.title",
      "zones": {
        "kpis": [
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_solde_caisse",
            "i18n_key": "kpi.solde_caisse.label",
            "props": {
              "format": "currency",
              "currency_source": "tenant.config.currency",
              "font": "mono"
            },
            "source": {
              "type": "kpi",
              "module_id": "module_cloture_caisse",
              "query": { "metric": "current_solde", "scope": "own" }
            },
            "visible_if": { "operator": "role", "value": "COMMERCIAL" }
          }
        ],
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "ProductGrid",
            "id": "product_grid_quick_sale",
            "i18n_key": "grid.products.title",
            "props": { "page_size": 12, "layout": "compact" },
            "source": {
              "type": "module_data",
              "module_id": "module_stock",
              "query": { "entity": "Product", "filter": { "active": true } }
            }
          },
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_sell_cta",
            "i18n_key": "action.sell.label",
            "props": {
              "variant": "primary",
              "size": "xl",
              "navigate_to": "module_ventes/vente_create"
            }
          }
        ],
        "aside": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_my_recent_sales",
            "i18n_key": "table.my_sales_today.title",
            "props": { "columns": ["created_at", "total_amount", "payment_method"], "limit": 5 },
            "source": {
              "type": "module_data",
              "module_id": "module_ventes",
              "query": {
                "entity": "Vente",
                "filter": { "period": "today" },
                "scope": "own"
              }
            }
          }
        ]
      }
    }
  ]
}
