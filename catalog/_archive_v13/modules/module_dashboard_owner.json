{
  "id": "module_dashboard_owner",
  "schema_version": "1.0.0",
  "name": "Dashboard Propriétaire",
  "i18n_key": "module.dashboard_owner.name",
  "icon": "dashboard",
  "rbac_roles": ["OWNER"],
  "conflict_strategy": "server_wins",
  "entities": [],
  "actions": {},
  "screens": [
    {
      "screen": "dashboard_owner_v1",
      "schema_version": "1.0.0",
      "layout": "dashboard",
      "i18n_key": "screen.dashboard_owner.title",
      "zones": {
        "kpis": [
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_ca_jour",
            "i18n_key": "kpi.ca_today.label",
            "props": {
              "format": "currency",
              "currency_source": "tenant.config.currency",
              "font": "mono"
            },
            "source": {
              "type": "kpi",
              "module_id": "module_ventes",
              "query": { "metric": "sum_total_amount", "period": "today" }
            },
            "visible_if": { "operator": "role", "value": "OWNER" }
          },
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_nb_ventes_jour",
            "i18n_key": "kpi.nb_ventes_today.label",
            "props": { "format": "integer", "font": "mono" },
            "source": {
              "type": "kpi",
              "module_id": "module_ventes",
              "query": { "metric": "count", "period": "today" }
            },
            "visible_if": { "operator": "role", "value": "OWNER" }
          },
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_alertes_stock",
            "i18n_key": "kpi.alertes_stock.label",
            "props": { "format": "integer", "font": "mono", "trend_color": "warning" },
            "source": {
              "type": "kpi",
              "module_id": "module_stock",
              "query": { "metric": "count_under_threshold" }
            },
            "visible_if": { "operator": "role", "value": "OWNER" }
          },
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_pertes_jour",
            "i18n_key": "kpi.pertes_today.label",
            "props": {
              "format": "currency",
              "currency_source": "tenant.config.currency",
              "font": "mono"
            },
            "source": {
              "type": "kpi",
              "module_id": "module_pertes",
              "query": { "metric": "sum_value", "period": "today" }
            },
            "visible_if": { "operator": "role", "value": "OWNER" }
          }
        ],
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "LineChart",
            "id": "chart_ventes_7j",
            "i18n_key": "chart.ventes_7d.title",
            "props": { "axis_x": "date", "axis_y": "total_amount" },
            "source": {
              "type": "kpi",
              "module_id": "module_ventes",
              "query": { "metric": "sum_total_amount", "group_by": "day", "period": "last_7_days" }
            }
          },
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_clotures_a_valider",
            "i18n_key": "table.clotures_pending.title",
            "props": {
              "columns": ["date", "commercial_id", "fond_final", "status"],
              "action_inline_id": "btn_valider_cloture"
            },
            "source": {
              "type": "module_data",
              "module_id": "module_cloture_caisse",
              "query": { "filter": { "status": "awaiting_owner_validation" } }
            }
          }
        ],
        "aside": [
          {
            "schema_version": "1.0.0",
            "type": "NotificationCenter",
            "id": "notif_center_evening",
            "i18n_key": "notif.evening.title",
            "props": { "channel": "evening_recap" }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_voir_ventes",
            "i18n_key": "action.view_sales.label",
            "props": { "variant": "secondary", "navigate_to": "module_ventes/ventes_list" }
          }
        ]
      }
    }
  ]
}
