{
  "id": "module_pertes",
  "schema_version": "1.0.0",
  "name": "Pertes",
  "i18n_key": "module.pertes.name",
  "icon": "report_problem",
  "rbac_roles": ["OWNER", "MANAGER", "COMMERCIAL"],
  "conflict_strategy": "manual",
  "entities": [
    {
      "name": "Perte",
      "i18n_key": "entity.perte.name",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary": true },
        { "name": "product_id", "type": "fk_entity", "ref": "Product", "required": true },
        { "name": "variante_id", "type": "fk_entity", "ref": "ProductVariant", "required": false },
        { "name": "quantity", "type": "decimal", "required": true, "min": 0 },
        {
          "name": "cause",
          "type": "enum",
          "values": ["casse", "peremption", "vol", "demarque_inconnue", "autre"],
          "required": true,
          "i18n_key": "field.perte_cause.label"
        },
        { "name": "location_id", "type": "fk_entity", "ref": "Location", "required": true },
        { "name": "photo_url", "type": "url", "required": false },
        { "name": "declared_by", "type": "fk_user", "required": true, "auto": "current_user" },
        { "name": "validated_by", "type": "fk_user", "required": false },
        { "name": "validated_at", "type": "datetime", "required": false },
        {
          "name": "status",
          "type": "enum",
          "values": ["declared", "validated_by_manager", "approved", "rejected"],
          "default": "declared",
          "i18n_key": "field.perte_status.label"
        },
        { "name": "created_at", "type": "datetime", "auto": "now" }
      ]
    }
  ],
  "actions": {
    "create_perte": {
      "handler": "crud.create",
      "entity_type": "Perte",
      "i18n_key": "action.create_perte.label",
      "idempotent": true
    },
    "validate_perte": {
      "handler": "crud.update",
      "entity_type": "Perte",
      "i18n_key": "action.validate_perte.label"
    },
    "reject_perte": {
      "handler": "crud.update",
      "entity_type": "Perte",
      "i18n_key": "action.reject_perte.label"
    }
  },
  "abac_rules": [
    { "action": "create", "subject": "Perte", "roles": ["COMMERCIAL", "MANAGER", "OWNER"] },
    { "action": "update", "subject": "Perte", "roles": ["MANAGER", "OWNER"] },
    { "action": "read", "subject": "Perte", "roles": ["OWNER", "MANAGER"] }
  ],
  "workflows": {
    "wf_perte_validation": {
      "id": "wf_perte_validation",
      "schema_version": "1.0.0",
      "initial_state": "declared",
      "states": {
        "declared": {
          "transitions": { "submit_for_validation": "awaiting_manager_validation" }
        },
        "awaiting_manager_validation": {
          "transitions": { "approve": "approved", "reject": "rejected" }
        },
        "approved": { "final": true },
        "rejected": { "final": true }
      }
    }
  },
  "screens": [
    {
      "screen": "pertes_list",
      "schema_version": "1.0.0",
      "layout": "list",
      "i18n_key": "screen.pertes_list.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_pertes",
            "props": {
              "columns": [
                "created_at",
                "product_id",
                "quantity",
                "cause",
                "status",
                "location_id"
              ]
            },
            "source": {
              "type": "module_data",
              "module_id": "module_pertes",
              "query": { "entity": "Perte" }
            }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_new_perte",
            "i18n_key": "action.declare_perte.label",
            "props": { "variant": "primary", "navigate_to": "module_pertes/perte_create" }
          }
        ]
      }
    },
    {
      "screen": "perte_create",
      "schema_version": "1.0.0",
      "layout": "form",
      "i18n_key": "screen.perte_create.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "FormSection",
            "id": "form_perte",
            "i18n_key": "form.perte_create.section",
            "props": {
              "entity": "Perte",
              "submit_action": "create_perte",
              "fields": [
                "product_id",
                "variante_id",
                "quantity",
                "cause",
                "location_id",
                "photo_url"
              ]
            }
          }
        ]
      }
    },
    {
      "screen": "perte_detail",
      "schema_version": "1.0.0",
      "layout": "detail",
      "i18n_key": "screen.perte_detail.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DetailView",
            "id": "detail_perte",
            "props": { "entity": "Perte" },
            "source": {
              "type": "module_data",
              "module_id": "module_pertes",
              "query": { "entity": "Perte", "by_id": true }
            }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_validate_perte",
            "i18n_key": "action.validate_perte.label",
            "props": { "variant": "primary", "action_id": "validate_perte" },
            "visible_if": {
              "operator": "OR",
              "children": [
                { "operator": "role", "value": "MANAGER" },
                { "operator": "role", "value": "OWNER" }
              ]
            }
          },
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_reject_perte",
            "i18n_key": "action.reject_perte.label",
            "props": { "variant": "danger", "action_id": "reject_perte" },
            "visible_if": {
              "operator": "OR",
              "children": [
                { "operator": "role", "value": "MANAGER" },
                { "operator": "role", "value": "OWNER" }
              ]
            }
          }
        ]
      }
    }
  ]
}
