{
  "id": "retail_fresh_produce",
  "schema_version": "1.0.0",
  "name": "Produits Frais Retail — Blandine",
  "icon": "store",
  "entities": [
    {"name": "Product", "display_name": "Produit", "fields": [
      {"name": "name", "type": "string", "required": true}, {"name": "category", "type": "string"}, {"name": "stock_quantity", "type": "number"}, {"name": "min_threshold", "type": "number"}, {"name": "price_per_unit", "type": "number"}
    ]},
    {"name": "Sale", "display_name": "Vente", "fields": [
      {"name": "product_id", "type": "string", "required": true}, {"name": "quantity", "type": "number", "required": true}, {"name": "amount", "type": "number", "required": true}, {"name": "payment_method", "type": "string"}, {"name": "timestamp", "type": "date"}
    ]},
    {"name": "Loss", "display_name": "Perte", "fields": [
      {"name": "product_id", "type": "string", "required": true}, {"name": "quantity", "type": "number", "required": true}, {"name": "nature", "type": "string"}, {"name": "note", "type": "string"}
    ]},
    {"name": "Delivery", "display_name": "Livraison", "fields": [
      {"name": "supplier", "type": "string", "required": true}, {"name": "reference_bl", "type": "string"}, {"name": "items", "type": "array"}, {"name": "status", "type": "string"}
    ]}
  ],
  "rbac_roles": ["OWNER", "MANAGER", "COMMERCIAL"],
  "screens": [
    {
      "screen": "dashboard_owner",
      "root": {
        "type": "Scaffold",
        "props": {
          "appBar": {
            "type": "AppBar",
            "props": {
              "title": "SCALARIO",
              "centerTitle": false,
              "actions": [
                {"type": "Button", "variant": "icon-only", "props": {"icon": "notifications"}}
              ]
            }
          },
          "bottomNav": {
            "type": "BottomNav",
            "props": {
              "currentIndex": 0,
              "items": [
                {"icon": "home", "label": "Accueil"},
                {"icon": "inventory_2", "label": "Stock"},
                {"icon": "history", "label": "Hist."},
                {"icon": "group", "label": "Equipe"},
                {"icon": "settings", "label": "Plus"}
              ]
            }
          }
        },
        "children": [
          {
            "type": "AlertBanner", "variant": "info",
            "props": {"type": "critical", "message": "2 articles en stock critique"}
          },
          {
            "type": "Grid",
            "props": {"columns": [2], "gap": 8, "responsive": {"mobile": {"columns": [2]}, "desktop": {"columns": [4]}}},
            "children": [
              {"type": "KPICard", "variant": "default", "props": {"label": "CA du jour", "value": "47 500 FCFA", "delta": "+12%", "delta_positive": true}},
              {"type": "KPICard", "variant": "default", "props": {"label": "Marge brute", "value": "14 200 FCFA", "delta": "30%", "delta_positive": true}},
              {"type": "KPICard", "variant": "default", "props": {"label": "Transactions", "value": "18", "delta": "+3", "delta_positive": true}},
              {"type": "KPICard", "variant": "default", "props": {"label": "Stock critique", "value": "2", "delta": "Tomates, Bananes", "delta_positive": false, "status": "critical"}}
            ]
          },
          {"type": "ChartBar", "variant": "default", "props": {"title": "CA 7 jours", "data": [
            {"label":"Lun","value":32},{"label":"Mar","value":45},{"label":"Mer","value":38},{"label":"Jeu","value":55},{"label":"Ven","value":62},{"label":"Sam","value":47},{"label":"Dim","value":28}
          ]}},
          {"type": "DataTable", "variant": "default", "props": {
            "columns": [{"key":"produit","label":"Produit"}, {"key":"qte","label":"Qte"}, {"key":"prix","label":"Prix"}, {"key":"heure","label":"Heure"}],
            "rows": [
              {"produit":"Tomates 2.5kg","qte":"1","prix":"3 750 F","heure":"08h33"},
              {"produit":"Bananes 3kg","qte":"1","prix":"1 500 F","heure":"08h12"},
              {"produit":"Oignons 5kg","qte":"1","prix":"2 500 F","heure":"07h45"}
            ]
          }},
          {
            "type": "Row",
            "props": {"gap": 8},
            "children": [
              {"type": "Button", "variant": "primary", "props": {"label": "Rapports", "icon": "bar_chart"}},
              {"type": "Button", "variant": "primary", "props": {"label": "Stock", "icon": "inventory_2"}},
              {"type": "Button", "variant": "primary", "props": {"label": "Equipe", "icon": "group"}}
            ]
          },
          {"type": "SyncStatusBar", "variant": "default", "props": {"status": "synced"}}
        ]
      }
    }
  ]
}
