{
  "id": "module_dashboard_manager",
  "schema_version": "1.0.0",
  "name": "Dashboard Gestionnaire",
  "i18n_key": "module.dashboard_manager.name",
  "icon": "assignment_turned_in",
  "rbac_roles": ["MANAGER"],
  "conflict_strategy": "server_wins",
  "entities": [],
  "actions": {},
  "screens": [
    {
      "screen": "dashboard_manager_v1",
      "schema_version": "1.0.0",
      "layout": "dashboard",
      "i18n_key": "screen.dashboard_manager.title",
      "zones": {
        "kpis": [
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_arrivages_pending",
            "i18n_key": "kpi.arrivages_pending.label",
            "props": { "format": "integer", "font": "mono" },
            "source": {
              "type": "kpi",
              "module_id": "module_stock",
              "query": { "metric": "count_arrivages_pending" }
            },
            "visible_if": { "operator": "role", "value": "MANAGER" }
          },
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_alertes_stock_bas",
            "i18n_key": "kpi.alertes_stock.label",
            "props": { "format": "integer", "font": "mono", "trend_color": "warning" },
            "source": {
              "type": "kpi",
              "module_id": "module_stock",
              "query": { "metric": "count_under_threshold" }
            },
            "visible_if": { "operator": "role", "value": "MANAGER" }
          },
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "id": "kpi_clotures_a_valider",
            "i18n_key": "kpi.clotures_pending.label",
            "props": { "format": "integer", "font": "mono" },
            "source": {
              "type": "kpi",
              "module_id": "module_cloture_caisse",
              "query": { "metric": "count_pending_manager" }
            },
            "visible_if": { "operator": "role", "value": "MANAGER" }
          }
        ],
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_arrivages",
            "i18n_key": "table.arrivages_pending.title",
            "props": {
              "columns": ["bon_commande_ref", "fournisseur_id", "received_at", "status"],
              "action_inline_id": "btn_valider_arrivage"
            },
            "source": {
              "type": "module_data",
              "module_id": "module_stock",
              "query": { "entity": "Arrivage", "filter": { "status": "received" } }
            }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_new_arrivage",
            "i18n_key": "action.new_arrivage.label",
            "props": { "variant": "primary", "navigate_to": "module_stock/arrivages_form" }
          }
        ]
      }
    }
  ]
}
