{
  "id": "module_stock",
  "schema_version": "1.0.0",
  "name": "Stock",
  "i18n_key": "module.stock.name",
  "icon": "inventory",
  "rbac_roles": ["OWNER", "MANAGER", "COMMERCIAL"],
  "conflict_strategy": "server_wins",
  "entities": [
    {
      "name": "Product",
      "i18n_key": "entity.product.name",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "sku", "type": "string", "required": false },
        { "name": "category_id", "type": "fk_entity", "ref": "Category", "required": false },
        { "name": "active", "type": "boolean", "default": true },
        {
          "name": "taux_de_frotte",
          "type": "decimal",
          "default": 0,
          "min": 0,
          "max": 1,
          "i18n_key": "field.taux_de_frotte.label"
        },
        {
          "name": "conversion_vrac_sachet",
          "type": "object",
          "required": false,
          "i18n_key": "field.conversion_vrac_sachet.label",
          "fields": [
            { "name": "from_unit", "type": "string", "required": true },
            { "name": "to_unit", "type": "string", "required": true },
            { "name": "from_qty", "type": "decimal", "required": true },
            { "name": "to_qty", "type": "decimal", "required": true },
            { "name": "sachet_weight_g", "type": "decimal", "required": false }
          ]
        },
        {
          "name": "freshness_indicator",
          "type": "enum",
          "values": ["green", "orange", "red"],
          "computed": "client_side",
          "i18n_key": "field.freshness.label"
        }
      ]
    },
    {
      "name": "Arrivage",
      "i18n_key": "entity.arrivage.name",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary": true },
        { "name": "fournisseur_id", "type": "fk_entity", "ref": "Fournisseur", "required": true },
        { "name": "bon_commande_ref", "type": "string", "required": false },
        {
          "name": "produits",
          "type": "array",
          "of": {
            "type": "object",
            "fields": [
              { "name": "product_id", "type": "fk_entity", "ref": "Product", "required": true },
              { "name": "qty_commandee", "type": "decimal", "required": true },
              { "name": "qty_recue", "type": "decimal", "required": false },
              {
                "name": "qty_validee",
                "type": "decimal",
                "required": false,
                "i18n_key": "field.qty_validee.label"
              }
            ]
          }
        },
        { "name": "received_at", "type": "datetime", "required": false },
        { "name": "validated_by", "type": "fk_user", "required": false },
        { "name": "validated_at", "type": "datetime", "required": false },
        {
          "name": "status",
          "type": "enum",
          "values": ["commande", "recu", "valide", "rejete"],
          "default": "commande",
          "i18n_key": "field.arrivage_status.label"
        },
        { "name": "created_at", "type": "datetime", "auto": "now" }
      ]
    },
    {
      "name": "SeuilStock",
      "i18n_key": "entity.seuil_stock.name",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary": true },
        { "name": "product_id", "type": "fk_entity", "ref": "Product", "required": true },
        {
          "name": "variante_id",
          "type": "fk_entity",
          "ref": "ProductVariant",
          "required": false
        },
        { "name": "seuil_min", "type": "decimal", "required": true, "min": 0 },
        { "name": "seuil_max", "type": "decimal", "required": false, "min": 0 },
        { "name": "location_id", "type": "fk_entity", "ref": "Location", "required": true }
      ]
    }
  ],
  "actions": {
    "create_arrivage": {
      "handler": "crud.create",
      "entity_type": "Arrivage",
      "i18n_key": "action.create_arrivage.label",
      "idempotent": true
    },
    "validate_arrivage": {
      "handler": "crud.update",
      "entity_type": "Arrivage",
      "i18n_key": "action.validate_arrivage.label"
    },
    "release_to_commercial": {
      "handler": "custom.release_to_commercial",
      "entity_type": "Arrivage",
      "i18n_key": "action.release_stock.label"
    },
    "update_seuil": {
      "handler": "crud.update",
      "entity_type": "SeuilStock",
      "i18n_key": "action.update_seuil.label"
    }
  },
  "abac_rules": [
    { "action": "create", "subject": "Arrivage", "roles": ["OWNER"] },
    { "action": "update", "subject": "Arrivage", "roles": ["MANAGER", "OWNER"] },
    { "action": "read", "subject": "Arrivage", "roles": ["OWNER", "MANAGER"] },
    { "action": "create", "subject": "SeuilStock", "roles": ["OWNER"] },
    { "action": "update", "subject": "SeuilStock", "roles": ["OWNER"] },
    { "action": "read", "subject": "Product", "roles": ["OWNER", "MANAGER", "COMMERCIAL"] }
  ],
  "screens": [
    {
      "screen": "arrivages_list",
      "schema_version": "1.0.0",
      "layout": "list",
      "i18n_key": "screen.arrivages_list.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_arrivages",
            "props": {
              "columns": ["created_at", "fournisseur_id", "bon_commande_ref", "status"]
            },
            "source": {
              "type": "module_data",
              "module_id": "module_stock",
              "query": { "entity": "Arrivage" }
            }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_new_arrivage",
            "i18n_key": "action.new_arrivage.label",
            "props": { "variant": "primary", "navigate_to": "module_stock/arrivages_form" },
            "visible_if": { "operator": "role", "value": "OWNER" }
          }
        ]
      }
    },
    {
      "screen": "arrivages_form",
      "schema_version": "1.0.0",
      "layout": "form",
      "i18n_key": "screen.arrivages_form.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "FormSection",
            "id": "form_arrivage",
            "i18n_key": "form.arrivage_create.section",
            "props": {
              "entity": "Arrivage",
              "submit_action": "create_arrivage",
              "fields": ["fournisseur_id", "bon_commande_ref", "produits"]
            },
            "visible_if": { "operator": "role", "value": "OWNER" }
          }
        ]
      }
    },
    {
      "screen": "arrivages_validation_form",
      "schema_version": "1.0.0",
      "layout": "form",
      "i18n_key": "screen.arrivages_validation_form.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "FormSection",
            "id": "form_arrivage_validation",
            "i18n_key": "form.arrivage_validation.section",
            "props": {
              "entity": "Arrivage",
              "submit_action": "validate_arrivage",
              "fields": ["produits"]
            },
            "visible_if": { "operator": "role", "value": "MANAGER" }
          }
        ]
      }
    },
    {
      "screen": "alertes_stock_list",
      "schema_version": "1.0.0",
      "layout": "list",
      "i18n_key": "screen.alertes_stock.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_alertes_stock",
            "props": {
              "columns": ["product_id", "current_qty", "seuil_min", "location_id"]
            },
            "source": {
              "type": "computed",
              "query": { "metric": "stock_under_threshold" }
            }
          }
        ]
      }
    }
  ]
}
