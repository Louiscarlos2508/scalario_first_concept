{
  "id": "module_ventes",
  "schema_version": "1.0.0",
  "name": "Ventes",
  "i18n_key": "module.ventes.name",
  "icon": "shopping_cart",
  "rbac_roles": ["OWNER", "MANAGER", "COMMERCIAL"],
  "conflict_strategy": "server_wins",
  "entities": [
    {
      "name": "Vente",
      "i18n_key": "entity.vente.name",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "primary": true },
        { "name": "commercial_id", "type": "fk_user", "required": true },
        {
          "name": "produits",
          "type": "array",
          "required": true,
          "of": {
            "type": "object",
            "fields": [
              { "name": "product_id", "type": "fk_entity", "ref": "Product", "required": true },
              { "name": "qty", "type": "decimal", "required": true, "min": 0 },
              {
                "name": "unit_price",
                "type": "currency",
                "currency_source": "tenant.config.currency",
                "required": true
              },
              {
                "name": "total",
                "type": "currency",
                "currency_source": "tenant.config.currency",
                "computed": "qty * unit_price"
              }
            ]
          }
        },
        {
          "name": "total_amount",
          "type": "currency",
          "currency_source": "tenant.config.currency",
          "computed": "sum(produits.total)"
        },
        {
          "name": "payment_method",
          "type": "enum",
          "values": ["cash", "mobile_money", "credit"],
          "required": true,
          "i18n_key": "field.payment_method.label"
        },
        {
          "name": "payment_provider",
          "type": "string",
          "required": false,
          "i18n_key": "field.payment_provider.label",
          "visible_if": {
            "operator": "==",
            "field": "payment_method",
            "value": "mobile_money"
          }
        },
        { "name": "location_id", "type": "fk_entity", "ref": "Location", "required": true },
        {
          "name": "status",
          "type": "enum",
          "values": ["draft", "confirmed", "refunded"],
          "default": "draft"
        },
        { "name": "created_at", "type": "datetime", "auto": "now" }
      ]
    }
  ],
  "actions": {
    "create_vente": {
      "handler": "crud.create",
      "entity_type": "Vente",
      "i18n_key": "action.create_vente.label",
      "idempotent": true
    },
    "confirm_vente": {
      "handler": "crud.update",
      "entity_type": "Vente",
      "i18n_key": "action.confirm_vente.label"
    },
    "refund_vente": {
      "handler": "custom.refund_vente",
      "entity_type": "Vente",
      "i18n_key": "action.refund_vente.label"
    }
  },
  "abac_rules": [
    { "action": "read", "subject": "Vente", "roles": ["OWNER", "MANAGER"] },
    { "action": "read", "subject": "Vente", "roles": ["COMMERCIAL"] },
    { "action": "create", "subject": "Vente", "roles": ["COMMERCIAL", "OWNER"] },
    { "action": "update", "subject": "Vente", "roles": ["MANAGER", "OWNER"] }
  ],
  "screens": [
    {
      "screen": "ventes_list",
      "schema_version": "1.0.0",
      "layout": "list",
      "i18n_key": "screen.ventes_list.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "id": "table_ventes",
            "props": {
              "columns": [
                "created_at",
                "commercial_id",
                "total_amount",
                "payment_method",
                "status"
              ]
            },
            "source": {
              "type": "module_data",
              "module_id": "module_ventes",
              "query": { "entity": "Vente" }
            },
            "visible_if": {
              "operator": "OR",
              "children": [
                { "operator": "role", "value": "OWNER" },
                { "operator": "role", "value": "MANAGER" },
                {
                  "operator": "AND",
                  "children": [
                    { "operator": "role", "value": "COMMERCIAL" },
                    { "operator": "==", "field": "ctx.scope", "value": "own" }
                  ]
                }
              ]
            }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_new_sale",
            "i18n_key": "action.new_sale.label",
            "props": { "variant": "primary", "navigate_to": "module_ventes/vente_create" },
            "visible_if": {
              "operator": "OR",
              "children": [
                { "operator": "role", "value": "COMMERCIAL" },
                { "operator": "role", "value": "OWNER" }
              ]
            }
          }
        ]
      }
    },
    {
      "screen": "vente_create",
      "schema_version": "1.0.0",
      "layout": "form",
      "i18n_key": "screen.vente_create.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "FormSection",
            "id": "form_vente",
            "i18n_key": "form.vente_create.section",
            "props": {
              "entity": "Vente",
              "submit_action": "create_vente",
              "fields": [
                "produits",
                "payment_method",
                "payment_provider",
                "location_id"
              ]
            },
            "visible_if": {
              "operator": "OR",
              "children": [
                { "operator": "role", "value": "COMMERCIAL" },
                { "operator": "role", "value": "OWNER" }
              ]
            }
          }
        ]
      }
    },
    {
      "screen": "ventes_detail",
      "schema_version": "1.0.0",
      "layout": "detail",
      "i18n_key": "screen.ventes_detail.title",
      "zones": {
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DetailView",
            "id": "detail_vente",
            "props": { "entity": "Vente" },
            "source": {
              "type": "module_data",
              "module_id": "module_ventes",
              "query": { "entity": "Vente", "by_id": true }
            }
          }
        ],
        "actions": [
          {
            "schema_version": "1.0.0",
            "type": "Button",
            "id": "btn_refund",
            "i18n_key": "action.refund.label",
            "props": { "variant": "danger", "action_id": "refund_vente" },
            "visible_if": {
              "operator": "OR",
              "children": [
                { "operator": "role", "value": "OWNER" },
                { "operator": "role", "value": "MANAGER" }
              ]
            }
          }
        ]
      }
    }
  ]
}
