{
  "id": "wf_cloture_caisse",
  "schema_version": "1.0.0",
  "initial_state": "saisie_fond_restant",
  "states": {
    "saisie_fond_restant": {
      "transitions": {
        "SUBMIT": "reconciliation_auto"
      },
      "on_enter": ["audit_step_entered"]
    },
    "reconciliation_auto": {
      "transitions": {
        "AUTO_PASS": "cloture_confirmee",
        "AUTO_REQUIRE_VALIDATION": "validation_manager"
      },
      "on_enter": ["compute_theoretical_vs_declared"]
    },
    "validation_manager": {
      "transitions": {
        "VALIDATE": "cloture_confirmee",
        "REQUEST_CORRECTION": "saisie_fond_restant",
        "REJECT": "litige"
      },
      "on_enter": ["notify_manager_pending_validation"]
    },
    "cloture_confirmee": {
      "final": true,
      "on_enter": ["audit_full_state_snapshot"]
    },
    "litige": {
      "final": true,
      "on_enter": ["notify_owner_litige"]
    }
  },
  "steps": {
    "compute_theoretical_vs_declared": {
      "id": "compute_theoretical_vs_declared",
      "type": "condition",
      "next": {
        "rules": [
          {
            "condition": {
              "operator": "<=",
              "field": "ctx.cash_gap_abs",
              "value": "tenant.config.cloture_auto_threshold"
            },
            "next": "auto_pass"
          }
        ],
        "default": "require_validation"
      }
    },
    "notify_manager_pending_validation": {
      "id": "notify_manager_pending_validation",
      "type": "notification",
      "params": {
        "template": "notif.cloture.pending_validation",
        "recipient_role": "MANAGER"
      }
    },
    "notify_owner_litige": {
      "id": "notify_owner_litige",
      "type": "notification",
      "params": {
        "template": "notif.cloture.litige",
        "recipient_role": "OWNER"
      }
    },
    "audit_step_entered": {
      "id": "audit_step_entered",
      "type": "action",
      "action": "custom.audit_log",
      "params": { "event": "workflow.step.entered" }
    },
    "audit_full_state_snapshot": {
      "id": "audit_full_state_snapshot",
      "type": "action",
      "action": "custom.audit_log",
      "params": { "event": "workflow.cloture.confirmed", "level": "info" }
    }
  }
}
