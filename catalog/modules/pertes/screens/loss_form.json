{
  "screen": "loss_form",
  "schema_version": "1.0.0",
  "layout": "form",
  "title": "Déclarer une perte",
  "zones": {
    "main": [
      { "type": "FormSection", "variant": "default", "props": { "title": "Perte" }, "children": [
        { "type": "Input", "variant": "default", "props": { "label": "Article", "name": "product_name", "required": true } },
        { "type": "Input", "variant": "number", "props": { "label": "Quantité", "name": "quantity", "required": true, "min": 0 } },
        { "type": "Dropdown", "variant": "default", "props": { "label": "Cause", "name": "cause", "required": true, "options": [ { "value": "avarie", "label": "Avarié" }, { "value": "casse", "label": "Casse" }, { "value": "vol", "label": "Vol" }, { "value": "autre", "label": "Autre" } ] } }
      ] }
    ],
    "actions": [
      { "type": "ActionButton", "variant": "primary", "props": { "label": "Soumettre", "full_width": true } }
    ]
  }
}
