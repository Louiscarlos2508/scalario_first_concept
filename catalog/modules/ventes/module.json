{
  "id": "ventes",
  "schema_version": "1.0.0",
  "name": "Ventes",
  "icon": "point_of_sale",
  "entities": [
    {
      "name": "Sale",
      "display_name": "Vente",
      "fields": [
        { "name": "id", "type": "string", "required": true },
        { "name": "items", "type": "array", "required": true },
        { "name": "total_amount", "type": "number", "required": true },
        { "name": "payment_method", "type": "string", "required": true },
        { "name": "payment_provider", "type": "string" },
        { "name": "created_by", "type": "string", "required": true },
        { "name": "created_at", "type": "date", "required": true },
        { "name": "session_id", "type": "string" },
        { "name": "status", "type": "string" }
      ]
    },
    {
      "name": "SaleItem",
      "display_name": "Ligne de vente",
      "fields": [
        { "name": "product_id", "type": "string", "required": true },
        { "name": "product_name", "type": "string", "required": true },
        { "name": "quantity", "type": "number", "required": true },
        { "name": "unit_price", "type": "number", "required": true },
        { "name": "total", "type": "number", "required": true },
        { "name": "input_type", "type": "string" }
      ]
    }
  ],
  "actions": {
    "create_sale": { "handler": "crud.create", "entity_type": "Sale", "label": "Nouvelle vente" },
    "list_sales": { "handler": "crud.read", "entity_type": "Sale", "label": "Ventes du jour" }
  },
  "screens": [
    "screens/pos.json",
    "screens/sale_list.json"
  ],
  "rbac_roles": ["COMMERCIAL", "MANAGER", "OWNER"]
}
