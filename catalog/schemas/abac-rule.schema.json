{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scalario.app/schemas/abac-rule.schema.json",
  "title": "Scalario ABAC Rule",
  "description": "Attribute-Based Access Control rule, declared in tenants.config.abac_rules[]. STORY-019.",
  "type": "object",
  "required": ["action", "subject", "roles"],
  "additionalProperties": false,
  "properties": {
    "action": {
      "description": "CRUD verb or custom action. 'manage' = wildcard.",
      "oneOf": [
        { "type": "string", "enum": ["read", "create", "update", "delete", "manage"] },
        { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
      ]
    },
    "subject": {
      "description": "Resource type name (PascalCase entity name).",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
    },
    "roles": {
      "description": "Tenant roles to which the rule applies (intersect with req.user.roles).",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$" }
    },
    "conditions": {
      "description": "MongoDB-like AST. Variables: $user.user_id, $user.tenant_id, $user.department_id, $user.metadata.<key>.",
      "type": "object",
      "additionalProperties": true
    },
    "fields": {
      "description": "Whitelist of readable/writable field names. Absent = all fields.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$" },
      "minItems": 1
    },
    "inverted": {
      "description": "If true, declares a 'cannot' rule (overrides 'can').",
      "type": "boolean",
      "default": false
    },
    "reason": {
      "description": "Free-text label for audit/debugging.",
      "type": "string",
      "maxLength": 256
    }
  }
}
