{
  "$id": "https://scalario.io/schemas/v2.0.0/component-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComponentConfig v2",
  "description": "Composant BDUI v2 avec contrat strict — props typés, actions typées, slots explicites, validation bloquante.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique du composant dans la zone."
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Identifiant du composant DS (ex: 'KPICard', 'ActionButton', 'ProductGrid'). Correspond au ComponentBuilder enregistré dans Flutter."
    },
    "variant": {
      "type": "string",
      "default": "default",
      "description": "Variante d'affichage (ex: 'compact', 'hero', 'default', 'out_of_stock'). Chaque variante a son propre schéma de props."
    },
    "props": {
      "type": "object",
      "description": "Props du composant. Validé par le schéma spécifique au type+variant. Rejeté si le schéma échoue.",
      "default": {}
    },
    "visible_if": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/Rule" }
      ],
      "description": "Règle conditionnelle de visibilité. Si null, toujours visible."
    },
    "source": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/DataSource" }
      ],
      "description": "Source de données dynamique. Si null, props statiques uniquement."
    },
    "actions": {
      "type": "array",
      "description": "Actions déclenchées par le composant. Typées par type d'action.",
      "items": { "$ref": "#/$defs/Action" }
    },
    "children": {
      "type": "array",
      "description": "Composants enfants (composition récursive).",
      "items": { "$ref": "#" }
    },
    "i18n_key": {
      "type": "string",
      "description": "Clé i18n pour le label du composant."
    }
  },
  "required": ["type", "props"],
  "additionalProperties": false,
  "$defs": {
    "Action": {
      "type": "object",
      "description": "Action typée BDUI v2. Le type détermine le comportement et les champs requis.",
      "properties": {
        "trigger": {
          "type": "string",
          "default": "tap",
          "description": "Événement qui déclenche l'action (tap, submit, change, scan_success, etc.)."
        },
        "type": {
          "enum": [
            "navigate", "sheet", "dialog", "confirm",
            "api_call", "local", "toast", "show_alert",
            "add_to_cart", "remove_from_cart", "update_cart_item",
            "toggle_credit_mode", "clear_cart", "retry"
          ],
          "description": "Type d'action. Navigate = aller vers un écran. Sheet = ouvrir un bottom sheet. Dialog = boîte de dialogue. Confirm = confirmation avant action. Api_call = requête HTTP. Local = action locale Flutter. Toast = notification temporaire. Show_alert = bannière d'alerte. Cart actions = spécifiques au POS."
        },
        "target": {
          "type": "string",
          "description": "Cible de l'action (ex: 'cart', 'product_grid', screen ID)."
        },
        "screen": {
          "type": "string",
          "description": "Écran de destination pour les actions navigate/sheet."
        },
        "dialog": {
          "type": "string",
          "description": "Identifiant du dialog à afficher."
        },
        "confirm_key": {
          "type": "string",
          "description": "Clé i18n pour le message de confirmation."
        },
        "then": {
          "$ref": "#/$defs/Action",
          "description": "Action à exécuter après confirmation (pour confirm)."
        },
        "message_key": {
          "type": "string",
          "description": "Clé i18n du message (pour toast/show_alert)."
        },
        "variant": {
          "type": "string",
          "description": "Variante d'alerte (error, success, info, warning)."
        },
        "endpoint": {
          "type": "string",
          "description": "Endpoint API pour api_call."
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"],
          "default": "GET"
        },
        "params": {
          "type": "object",
          "description": "Paramètres de la requête ou de l'action locale."
        },
        "duration_ms": {
          "type": "integer",
          "description": "Durée d'affichage en ms (pour toast)."
        }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["navigate", "sheet"] } } },
          "then": { "required": ["screen"] }
        },
        {
          "if": { "properties": { "type": { "const": "confirm" } } },
          "then": { "required": ["confirm_key", "then"] }
        },
        {
          "if": { "properties": { "type": { "const": "add_to_cart" } } },
          "then": { "required": ["target"] }
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in", "AND", "OR"] },
        "value": {},
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Rule" }
        }
      },
      "required": ["field", "operator"]
    },
    "DataSource": {
      "type": "object",
      "properties": {
        "$ref": { "type": "string" },
        "endpoint": { "type": "string" },
        "method": { "type": "string", "default": "GET" },
        "local": { "type": "boolean" },
        "path": { "type": "string" },
        "cache_ttl_ms": { "type": "integer" },
        "refresh_ms": { "type": "integer" },
        "params": { "type": "object" },
        "fixtures": { "type": "array" }
      },
      "anyOf": [
        { "required": ["$ref"] },
        { "required": ["endpoint"] },
        { "required": ["local"] }
      ]
    }
  }
}