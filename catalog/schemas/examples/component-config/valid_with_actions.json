{
  "schema_version": "1.1.0",
  "type": "Button",
  "variant": "default",
  "id": "save-btn",
  "props": {
    "label": "Enregistrer"
  },
  "actions": [
    {
      "registry": "vault",
      "fn": "save_entity",
      "inputs": {
        "entity": "Vente",
        "data": {
          "$ref": "$form.values"
        }
      },
      "output": "saved_vente",
      "on_error": {
        "network": "notify",
        "validation": "fail"
      }
    },
    {
      "registry": "canvas",
      "fn": "navigate",
      "inputs": {
        "route": "/dashboard",
        "params": {
          "id": "$outputs.saved_vente.id"
        }
      }
    }
  ]
}
