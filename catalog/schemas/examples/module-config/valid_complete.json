{
  "id": "retail_fresh_produce",
  "schema_version": "1.0.0",
  "name": "Produits Frais Retail",
  "i18n_key": "modules.retail_fresh_produce",
  "icon": "shopping_basket",
  "entities": [
    {
      "name": "Product",
      "display_name": "Produit",
      "i18n_key": "entities.product",
      "fields": [
        { "name": "label", "type": "string", "required": true, "i18n_key": "fields.product.label" },
        { "name": "price", "type": "number", "required": true, "i18n_key": "fields.product.price" },
        { "name": "stock", "type": "number", "required": false },
        { "name": "category", "type": "reference", "required": true }
      ]
    },
    {
      "name": "Order",
      "display_name": "Commande",
      "i18n_key": "entities.order",
      "fields": [
        { "name": "total", "type": "number", "required": true },
        { "name": "status", "type": "string" },
        { "name": "created_at", "type": "date" }
      ]
    }
  ],
  "screens": [
    {
      "screen": "dashboard",
      "schema_version": "1.0.0",
      "layout": "dashboard",
      "title": "Tableau de bord",
      "zones": {
        "kpis": [
          {
            "schema_version": "1.0.0",
            "type": "KPICard",
            "props": { "title": "Ventes du jour" },
            "source": { "type": "kpi", "module_id": "retail_fresh_produce", "query": { "metric": "daily_sales" } }
          }
        ],
        "main": [
          {
            "schema_version": "1.0.0",
            "type": "DataTable",
            "props": { "columns": ["label", "price", "stock"], "striped": true },
            "source": { "type": "module_data", "module_id": "retail_fresh_produce", "query": { "entity": "Product" } }
          }
        ]
      }
    }
  ],
  "actions": {
    "create_product": {
      "handler": "crud.create",
      "entity_type": "Product",
      "label": "Créer un produit",
      "i18n_key": "actions.create_product"
    },
    "delete_product": {
      "handler": "crud.delete",
      "entity_type": "Product",
      "label": "Supprimer"
    },
    "advance_order": {
      "handler": "workflow.advance",
      "label": "Avancer la commande"
    }
  },
  "workflows": {
    "wf_checkout": {
      "id": "wf_checkout",
      "schema_version": "1.0.0",
      "initial_state": "draft",
      "states": {
        "draft": {
          "transitions": { "submit": "pending_approval" }
        },
        "pending_approval": {
          "transitions": { "approve": "approved", "reject": "rejected" }
        },
        "approved": {
          "transitions": { "complete": "completed" }
        },
        "rejected": {
          "final": true
        },
        "completed": {
          "final": true
        }
      }
    }
  },
  "rbac_roles": ["OWNER", "MANAGER", "COMMERCIAL"],
  "abac_rules": [
    {
      "action": "read",
      "subject": "Product",
      "roles": ["OWNER", "MANAGER", "COMMERCIAL"]
    },
    {
      "action": "create",
      "subject": "Product",
      "roles": ["OWNER", "MANAGER"]
    }
  ],
  "conflict_strategy": "server_wins"
}