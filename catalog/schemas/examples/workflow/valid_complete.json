{
  "id": "wf_order_approval",
  "schema_version": "1.0.0",
  "initial_state": "pending",
  "states": {
    "pending": {
      "transitions": {
        "approve": "approved",
        "reject": "rejected"
      },
      "on_enter": ["notify_manager"],
      "on_exit": ["log_state_change"]
    },
    "approved": {
      "transitions": {
        "complete": "completed"
      },
      "on_enter": ["notify_requester"]
    },
    "rejected": {
      "final": true
    },
    "completed": {
      "final": true,
      "on_enter": ["archive_order"]
    }
  },
  "steps": {
    "notify_manager": {
      "id": "notify_manager",
      "type": "notification",
      "next": "wait_approval",
      "params": {
        "template": "order_approval_request",
        "recipient_role": "MANAGER"
      }
    },
    "wait_approval": {
      "id": "wait_approval",
      "type": "approval",
      "next": {
        "rules": [
          {
            "condition": {
              "operator": "==",
              "field": "approval.result",
              "value": "approved"
            },
            "next": "process_approval"
          }
        ],
        "default": "process_rejection"
      }
    },
    "process_approval": {
      "id": "process_approval",
      "type": "action",
      "action": "crud.update",
      "next": "log_result",
      "params": {
        "entity": "Order",
        "status": "approved"
      }
    },
    "process_rejection": {
      "id": "process_rejection",
      "type": "action",
      "action": "crud.update",
      "next": "log_result",
      "params": {
        "entity": "Order",
        "status": "rejected"
      }
    },
    "log_result": {
      "id": "log_result",
      "type": "action",
      "action": "custom.log",
      "params": {
        "level": "info"
      }
    }
  }
}