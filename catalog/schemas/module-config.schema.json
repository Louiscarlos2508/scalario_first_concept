{
  "$id": "https://scalario.io/schemas/v2.0.0/module-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleConfig v2",
  "description": "Configuration d'un module métier BDUI v2.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "2.0.0" },
    "name": { "type": "string" },
    "icon": { "type": "string" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "display_name": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" }
              },
              "required": ["name", "type"]
            }
          }
        },
        "required": ["name", "display_name", "fields"]
      }
    },
    "actions": { "type": "object" },
    "rbac_roles": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["id", "schema_version", "name"],
  "additionalProperties": false
}