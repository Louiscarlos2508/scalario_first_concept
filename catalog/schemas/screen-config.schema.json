{
  "$id": "https://scalario.io/schemas/v2.0.0/screen-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreenConfig v2",
  "description": "Configuration d'un écran BDUI v2. Organisation en dossier avec références $ref. Validation bloquante.",
  "type": "object",
  "properties": {
    "screen": {
      "type": "string",
      "minLength": 1,
      "description": "Identifiant unique de l'écran (ex: 'pos_caisse', 'dashboard_owner')."
    },
    "schema_version": {
      "const": "2.0.0",
      "description": "Version du schéma BDUI. v2.0.0 = dossier avec $ref, contrat strict, actions typées."
    },
    "layout": {
      "oneOf": [
        { "$ref": "#/$defs/Ref" },
        { "$ref": "#/$defs/LayoutConfig" }
      ],
      "description": "Configuration du layout. Peut être une référence $ref vers layout.json ou un objet inline."
    },
    "title": {
      "type": "string",
      "description": "Titre affiché de l'écran."
    },
    "roles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rôles autorisés à voir cet écran. ['*'] = tous les rôles."
    },
    "zones": {
      "type": "object",
      "description": "Zones de l'écran. Chaque clé = nom du slot, chaque valeur = $ref vers le fichier zone ou un tableau de composants.",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/Ref" },
          { "type": "array", "items": { "$ref": "https://scalario.io/schemas/v2.0.0/component-config.schema.json" } }
        ]
      },
      "minProperties": 1
    },
    "capabilities": {
      "oneOf": [
        { "$ref": "#/$defs/Ref" },
        { "type": "object" }
      ],
      "description": "Capacités spécifiques à l'écran (scan, offline, paiement, etc.)."
    },
    "components": {
      "type": "object",
      "description": "Définition des composants spécifiques à l'écran. Chaque clé = nom du composant, valeur = $ref ou définition inline.",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/Ref" },
          { "$ref": "https://scalario.io/schemas/v2.0.0/component-config.schema.json" }
        ]
      }
    },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/Ref" },
        { "type": "object" }
      ],
      "description": "Sources de données utilisées par l'écran (endpoints, fixtures, cache)."
    },
    "rules": {
      "oneOf": [
        { "$ref": "#/$defs/Ref" },
        { "type": "array", "items": { "$ref": "#/$defs/Rule" } }
      ],
      "description": "Règles globales de l'écran (RBAC, visibilité, state machine)."
    },
    "states": {
      "type": "object",
      "description": "États visuels de l'écran (loading, empty, error, offline).",
      "properties": {
        "loading": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] },
        "empty": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] },
        "offline": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] }
      }
    },
    "i18n": {
      "oneOf": [
        { "$ref": "#/$defs/Ref" },
        { "type": "object" }
      ],
      "description": "Traductions pour l'écran."
    },
    "ux": {
      "type": "object",
      "description": "Spécifications UX dédiées (typographie, espacement, animations).",
      "properties": {
        "typography": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] },
        "spacing": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] },
        "animations": { "oneOf": [{ "$ref": "#/$defs/Ref" }, { "type": "object" }] }
      }
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "description": "Ordre d'affichage dans la navigation du module."
    }
  },
  "required": ["screen", "schema_version", "layout", "zones"],
  "additionalProperties": false,
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^(.+)\\.json(#/.*)?$",
          "description": "Chemin relatif vers le fichier référencé. Peut inclure un JSON pointer après #."
        }
      },
      "required": ["$ref"],
      "additionalProperties": false
    },
    "LayoutConfig": {
      "type": "object",
      "properties": {
        "version": { "const": "2.0.0" },
        "layout": { "type": "string" },
        "responsive": { "type": "object" },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "zone": { "type": "string" },
              "position": { "type": "string" },
              "sticky": { "type": "boolean" },
              "scroll": { "type": "boolean" },
              "visible_on": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["zone", "position"]
          }
        },
        "fallback": { "type": "object" }
      },
      "required": ["version", "layout", "slots"]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in", "AND", "OR"] },
        "value": {},
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Rule" }
        },
        "allow": { "type": "boolean" },
        "state": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["field", "operator"]
    }
  }
}