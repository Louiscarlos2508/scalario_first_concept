{
  "events": {
    "validation_required": {
      "trigger": "workflow:en_attente",
      "payload": { "commande_id": "$id", "montant": "$amount", "client": "$client_name" },
      "recipients": ["MANAGER", "OWNER"],
      "notification": { "badge": "validations", "message_key": "notification.validation" }
    },
    "stock_critical": {
      "trigger": "calc:low_stock",
      "payload": { "produit": "$product.name", "qty": "$product.stock_quantity", "seuil": "$product.min_threshold" },
      "recipients": ["OWNER"],
      "notification": { "alert_banner": "critical", "badge": "stock" }
    },
    "data_updated": {
      "trigger": "vault:after_write",
      "invalidate_cache": ["$source"]
    },
    "perte_declaree": {
      "trigger": "crud:create_loss",
      "payload": { "produit": "$loss.product_id", "nature": "$loss.nature" },
      "recipients": ["OWNER"],
      "notification": { "badge": "pertes" }
    },
    "session_expired": {
      "trigger": "auth:token_expired",
      "payload": { "reason": "session_expired" }
    }
  }
}
