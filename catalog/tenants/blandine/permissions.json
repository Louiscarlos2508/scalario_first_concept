{
  "permissions": {
    "OWNER": {
      "all": true
    },
    "MANAGER": {
      "modules": ["ventes", "stock", "pertes", "caisse", "commandes", "equipe", "rapports", "alertes"],
      "actions": {
        "crud": { "create": true, "read": true, "update": true },
        "admin": false
      }
    },
    "COMMERCIAL": {
      "modules": ["ventes", "stock", "pertes", "caisse"],
      "actions": {
        "crud": { "create": true, "read": true, "update": false },
        "admin": false
      }
    }
  },
  "default_role": "COMMERCIAL"
}
