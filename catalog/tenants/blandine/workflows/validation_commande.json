{
  "workflow_id": "wf_validation_commande",
  "states": {
    "brouillon": {
      "transitions": [{ "to": "en_attente", "event": "SUBMIT", "roles": ["COMMERCIAL"] }]
    },
    "en_attente": {
      "transitions": [
        { "to": "validee", "event": "APPROVE", "roles": ["MANAGER", "OWNER"], "condition": "calc:marge_brute > 0" },
        { "to": "rejetee", "event": "REJECT", "roles": ["MANAGER", "OWNER"] }
      ]
    },
    "validee": {
      "transitions": [
        { "to": "livree", "event": "DELIVER", "roles": ["MANAGER"] }
      ],
      "on_enter": {
        "pipeline": ["update_stock", "send_confirmation"]
      }
    },
    "livree": { "final": true },
    "rejetee": { "final": true }
  },
  "initial_state": "brouillon"
}
